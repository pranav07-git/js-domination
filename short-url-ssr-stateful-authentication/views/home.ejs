<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Home Page</title>
    <style>
      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        min-height: 100vh;
        padding: 60px 20px;

        font-family: Inter, -apple-system, BlinkMacSystemFont, "Segoe UI",
          sans-serif;

        color: #f5f5f5;
        background: #090909;

        display: flex;
        flex-direction: column;
        align-items: center;
      }

      /* Background glow */
      body::before {
        content: "";
        position: fixed;

        width: 500px;
        height: 500px;

        top: -200px;
        left: -150px;

        background: rgba(255, 255, 255, 0.06);
        filter: blur(120px);

        pointer-events: none;
      }

      /* Heading */
      h1 {
        width: 100%;
        max-width: 900px;
        margin-bottom: 35px;
        font-size: 42px;
        font-weight: 600;
        letter-spacing: -1.5px;
      }

      h1 a{
        color: #fff;
        text-decoration: none;
      }

      /* Generated / status messages */
      body > p {
        width: 100%;
        max-width: 900px;

        margin-bottom: 12px;
        padding: 14px 18px;

        font-size: 14px;
        color: #d4d4d4;

        background: rgba(255, 255, 255, 0.04);

        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 12px;

        backdrop-filter: blur(16px);
        -webkit-backdrop-filter: blur(16px);
      }

      /* Form section */
      body > div {
        width: 100%;
        max-width: 900px;
      }

      /* Form */
      form {
        display: flex;
        align-items: center;
        gap: 12px;

        margin-bottom: 35px;
        padding: 18px;

        background: rgba(255, 255, 255, 0.045);

        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 16px;

        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);

        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.35),
          inset 0 1px 0 rgba(255, 255, 255, 0.05);
      }

      label {
        display: none;
      }

      /* Input */
      input {
        flex: 1;

        min-width: 0;
        padding: 14px 16px;

        font-size: 15px;
        color: #fff;

        background: rgba(0, 0, 0, 0.35);

        border: 1px solid rgba(255, 255, 255, 0.12);
        border-radius: 10px;

        outline: none;

        transition: 0.2s ease;
      }

      input::placeholder {
        color: #666;
      }

      input:focus {
        border-color: rgba(255, 255, 255, 0.3);
        background: rgba(0, 0, 0, 0.5);
      }

      /* Button */
      button {
        padding: 14px 22px;

        border: 1px solid rgba(255, 255, 255, 0.15);
        border-radius: 10px;

        background: #f5f5f5;
        color: #0a0a0a;

        font-size: 14px;
        font-weight: 600;

        cursor: pointer;

        transition: 0.2s ease;
      }

      button:hover {
        background: #ffffff;
        transform: translateY(-1px);
      }

      button:active {
        transform: translateY(0);
      }

      /* Table */
      table {
        width: 100%;

        border-spacing: 0;
        overflow: hidden;

        background: rgba(255, 255, 255, 0.035);

        border: 1px solid rgba(255, 255, 255, 0.1);
        border-radius: 16px;

        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);

        box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);
      }

      /* Table heading */
      thead {
        background: rgba(255, 255, 255, 0.045);
      }

      th {
        padding: 16px 18px;

        text-align: left;

        color: #888;
        font-size: 12px;
        font-weight: 500;
        text-transform: uppercase;
        letter-spacing: 0.6px;

        border-bottom: 1px solid rgba(255, 255, 255, 0.08);
      }

      /* Table cells */
      td {
        padding: 17px 18px;

        color: #ddd;
        font-size: 14px;

        border-bottom: 1px solid rgba(255, 255, 255, 0.06);
      }

      tbody tr {
        transition: background 0.2s ease;
      }

      tbody tr:hover {
        background: rgba(255, 255, 255, 0.035);
      }

      tbody tr:last-child td {
        border-bottom: none;
      }

      /* URL column */
      td:nth-child(3) {
        color: #999;
        max-width: 350px;

        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
      }

      /* Short ID */
      td:nth-child(2) {
        font-family: monospace;
        color: #fff;
      }

      /* Mobile */
      @media (max-width: 650px) {
        body {
          padding: 35px 15px;
        }

        h1 {
          font-size: 32px;
        }

        form {
          flex-direction: column;
          align-items: stretch;
        }

        input,
        button {
          width: 100%;
        }

        table {
          font-size: 13px;
        }

        th,
        td {
          padding: 12px 10px;
        }

        td:nth-child(3) {
          max-width: 150px;
        }
      }
    </style>
  </head>
  <body>
    <h1><a href="http://localhost:8000/">URL Shortner</a></h1>
    <% if (locals.id) { %>
    <p>URL Generated: http://localhost:8000/url/<%= id %></p>
    <% } %> <% if (locals.existingId) { %>
    <p>
      URL already Generated for <%= existingUrl %>:
      http://localhost:8000/url/<%= existingId %>
    </p>
    <% } %> <% if (locals.invalidUrl) { %>
    <p>Invalid URl: <%= invalidUrl %></p>
    <% } %>

    <div>
      <form method="POST" action="/url">
        <label for="en">Enter your original URL</label>
        <input type="text" name="url" placeholder="https://example.com" />
        <button type="submit">Generate</button>
      </form>
    </div>

    <div>
      <% if (locals.urls && urls.length > 0) { %>
      <table>
        <thead>
          <tr>
            <th>S.no</th>
            <th>Short ID</th>
            <th>Redirect</th>
            <th>Clicks</th>
          </tr>
        </thead>
        <tbody>
          <% urls.forEach((url, index) => { %>
          <tr>
            <td><%= index+1 %></td>
            <td><%= url.shortId %></td>
            <td><%= url.redirectURL %></td>
            <td><%= url.visitedHistory.length %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
      <% } %>
    </div>
  </body>
</html>
